PORT=8000
CLASSIFICATION_API_KEY=
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu
HF_TOKEN=
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
TAXONOMY_PATH=taxonomy.json
EXAMPLES_PATH=
EMBEDDING_EXAMPLE_WEIGHT=1.0
CLASSIFICATION_TOP_K=5
CLASSIFICATION_THRESHOLD=0.0
CLASSIFICATION_TYPE=multi-label

# Default classification strategy: "local" (local bi-encoder only) or
# "albert" (Albert API bge-m3 retrieval + bge-reranker-v2-m3 rerank).
# Overridable per request via the `method` field.
CLASSIFICATION_METHOD=local

# Albert API (https://albert.api.etalab.gouv.fr) -- required for method=albert.
ALBERT_API_KEY=
ALBERT_BASE_URL=https://albert.api.etalab.gouv.fr/v1
ALBERT_EMBEDDING_MODEL=BAAI/bge-m3
ALBERT_RERANK_MODEL=BAAI/bge-reranker-v2-m3
ALBERT_QUERY_PREFIX=
ALBERT_PASSAGE_PREFIX=
ALBERT_TIMEOUT=30
ALBERT_EMBED_BATCH=64
# Bi-encoder candidate pool size handed to the cross-encoder reranker.
RERANK_CANDIDATES=20
